# ════════════════════════════════════════════════════════════════
#  CONFIGURATION — modifier uniquement ce fichier pour changer les URLs
# ════════════════════════════════════════════════════════════════

# URL interne du backend Django (utilisée par nginx proxy_pass dans le container)
BACKEND_URL=http://192.168.1.50:8030

# URL publique du frontend (baked dans le build Vite)
VITE_PUBLIC_URL=https://erh.camusatsn.com

# URL de l'API pour le code React (vide = URLs relatives, nginx/Vite proxy gèrent /api/)
# Laisser vide en prod Docker et en dev local avec Vite proxy.
# Mettre http://192.168.1.50:8030 uniquement si on lance npm run dev sans proxy.
VITE_API_URL=
